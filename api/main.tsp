import "@typespec/http";
import "@typespec/openapi";

using TypeSpec.Http;

@service(#{ title: "Call Calendar API" })
@OpenAPI.info(#{ version: "0.0.1" })
namespace CallCalendar;

/**
 * Ответ проверки живости сервиса.
 */
model HealthStatus {
  /**
   * Текущее состояние; живой сервис отвечает "ok".
   */
  status: string;
}

/**
 * Проверка живости сервиса.
 */
@route("/health")
@get
op health(): HealthStatus;

// ---------- Ошибки ----------

/**
 * Тело ошибки: machine-readable код + сообщение для человека.
 *
 * Коды (snake_case), используемые сервисом:
 * - `malformed_json` — тело запроса не является корректным JSON (400);
 * - `invalid_field_type` — поле запроса имеет неверный тип,
 *   например нецелая длительность (422);
 * - `invalid_date_format` — поле-дата (например startsAt Записи)
 *   не парсится как ISO 8601 дата-время со смещением (422);
 * - `empty_id` — пустой идентификатор Типа звонка (422);
 * - `empty_name` — пустое название Типа звонка (422);
 * - `duration_out_of_range` — Длительность звонка вне 5–240 минут (422);
 * - `duplicate_id` — идентификатор Типа звонка уже существует (409);
 * - `call_type_not_found` — Тип звонка по идентификатору не найден (404);
 * - `unknown_call_type` — Тип звонка при создании Записи не найден (422);
 * - `empty_guest_name` — пустое имя Гостя (422);
 * - `empty_guest_contact` — пустой контакт Гостя (422);
 * - `starts_at_in_past` — время начала Записи в прошлом (422);
 * - `outside_booking_window` — начало вне Окна записи — 14 календарных
 *   дней со следующего дня (422);
 * - `outside_working_hours` — начало вне Рабочих часов или Запись
 *   не вписывается в них целиком с учётом Длительности звонка (422);
 * - `start_not_on_grid` — старт не на сетке Слотов: не кратен 15 минутам
 *   от начала Рабочих часов (422);
 * - `slot_taken` — время пересекается с активной Записью любого
 *   Типа звонка (409);
 * - `missing_query_param` — обязательный query-параметр отсутствует,
 *   например `range` у списка Записей (400);
 * - `invalid_query_param` — query-параметр не разобран (400);
 * - `invalid_call_range` — значение `range` не из известных
 *   (единственное валидное — `upcoming`) (422);
 */
model ErrorBody {
  /**
   * Machine-readable код ошибки.
   */
  code: string;

  /**
   * Сообщение для человека.
   */
  message: string;
}

/**
 * Конфликт: дубликат идентификатора Типа звонка или время, занятое
 * активной Записью (интервалы полуоткрытые, примыкание не конфликт).
 */
@error
model ConflictError extends ConflictResponse {
  @body body: ErrorBody;
}

/**
 * Ошибка валидации данных запроса.
 */
@error
model ValidationError extends Response<422> {
  @body body: ErrorBody;
}

/**
 * Ресурс не найден.
 */
@error
model NotFoundError extends NotFoundResponse {
  @body body: ErrorBody;
}

// ---------- Типы звонков ----------

/**
 * Тип звонка: набор параметров, который задаёт Владелец страницы.
 */
model CallType {
  /**
   * Идентификатор: строковый, задаёт Владелец страницы.
   */
  id: string;

  /**
   * Название для отображения Гостю.
   */
  name: string;

  /**
   * Описание Типа звонка.
   */
  description: string;

  /**
   * Длительность звонка в минутах: целое от 5 до 240.
   */
  durationMinutes: int32;
}

/**
 * Данные для создания Типа звонка.
 */
model CreateCallTypeRequest {
  /**
   * Идентификатор: строковый, задаёт Владелец страницы.
   */
  id: string;

  /**
   * Название для отображения Гостю.
   */
  name: string;

  /**
   * Описание Типа звонка.
   */
  description: string;

  /**
   * Длительность звонка в минутах: целое от 5 до 240.
   */
  durationMinutes: int32;
}

/**
 * Тип звонка создан.
 */
model CallTypeCreated extends CreatedResponse {
  @body body: CallType;
}

/**
 * Список Типов звонков.
 */
model CallTypeList {
  /**
   * Созданные Типы звонков.
   */
  items: CallType[];
}

/**
 * Создать Тип звонка (Владелец страницы).
 */
@route("/api/call-types")
@post
op createCallType(@body body: CreateCallTypeRequest): CallTypeCreated | ConflictError | ValidationError;

/**
 * Список Типов звонков (публично: их видит Гость).
 */
@route("/api/call-types")
@get
op listCallTypes(): CallTypeList;

// ---------- Слоты ----------

/**
 * Слот: свободное место для Звонка внутри Окна записи и Рабочих часов,
 * вмещающее Звонок выбранного Типа звонка целиком (GLOSSARY.md).
 * Вычисляется на лету, не хранится.
 */
model Slot {
  /**
   * Начало Слота; ISO 8601 с явным смещением часового пояса.
   */
  startsAt: offsetDateTime;

  /**
   * Конец Слота: начало плюс Длительность звонка Типа звонка.
   */
  endsAt: offsetDateTime;
}

/**
 * Список Слотов Типа звонка на Окно записи.
 */
model SlotList {
  /**
   * Свободные Слоты внутри Окна записи, по порядку времени.
   */
  items: Slot[];
}

/**
 * Слоты Типа звонка (публично: их видит Гость): вычисленная сетка
 * на Окно записи — 14 календарных дней со следующего дня,
 * Рабочие часы 9:00–18:00 Europe/Moscow, старты каждые 15 минут.
 */
@route("/api/call-types/{id}/slots")
@get
op listSlots(id: string): SlotList | NotFoundError;

// ---------- Записи ----------

/**
 * Запись: забронированный Звонок Гостя с Владельцем страницы (GLOSSARY.md).
 *
 * Название и Длительность звонка Типа звонка дублируются в Записи
 * сознательно: экран подтверждения Гостя и предстоящие Звонки (#17)
 * показывают их без отдельного запроса; Типы звонков не редактируются,
 * поэтому рассинхронизоваться значения не могут. endsAt вычисляет
 * сервер: startsAt + Длительность звонка Типа звонка.
 */
model Call {
  /**
   * Идентификатор Типа звонка, на который создана Запись.
   */
  callTypeId: string;

  /**
   * Название Типа звонка на момент создания Записи (для показа Гостю и Владельцу).
   */
  callTypeName: string;

  /**
   * Длительность звонка в минутах — из Типа звонка.
   */
  durationMinutes: int32;

  /**
   * Начало Звонка; ISO 8601 с явным смещением часового пояса.
   */
  startsAt: offsetDateTime;

  /**
   * Конец Звонка: начало плюс Длительность звонка Типа звонка.
   */
  endsAt: offsetDateTime;

  /**
   * Имя Гостя.
   */
  guestName: string;

  /**
   * Контакт Гостя: как связаться по поводу Звонка.
   */
  guestContact: string;
}

/**
 * Данные для создания Записи (Гость). Длительность не передаётся:
 * она берётся из Типа звонка, endsAt вычисляет сервер. Запись
 * создаётся на выбранный Слот: начало — на сетке стартов внутри
 * Рабочих часов и Окна записи, без пересечения с активными Записями.
 */
model CreateCallRequest {
  /**
   * Идентификатор Типа звонка.
   */
  callTypeId: string;

  /**
   * Время начала Слота; ISO 8601 с явным смещением часового пояса.
   */
  startsAt: offsetDateTime;

  /**
   * Имя Гостя.
   */
  guestName: string;

  /**
   * Контакт Гостя: как связаться по поводу Звонка.
   */
  guestContact: string;
}

/**
 * Запись создана.
 */
model CallCreated extends CreatedResponse {
  @body body: Call;
}

/**
 * Создать Запись (Гость) на выбранный Слот: длительность — из Типа
 * звонка. Пересечение с активной Записью любого Типа звонка — 409;
 * ошибки данных (неизвестный тип, пустые имя/контакт, прошлое,
 * вне Окна записи или Рабочих часов, старт не на сетке, кривая дата)
 * — 422 с machine-readable кодом.
 */
@route("/api/calls")
@post
op createCall(@body body: CreateCallRequest): CallCreated | ConflictError | ValidationError;

/**
 * Диапазон списка Записей. `upcoming` — предстоящие: ещё не
 * начавшиеся Записи (граница: начало >= текущего момента).
 */
enum CallRange {
  upcoming: "upcoming";
}

/**
 * Список Записей. Пустой список — валидный ответ.
 */
model CallList {
  /**
   * Записи выбранного диапазона; предстоящие — по возрастанию начала.
   */
  items: Call[];
}

/**
 * Предстоящие Записи всех Типов звонков одним списком (Владелец
 * страницы, без входа): ещё не начавшиеся (начало >= текущего
 * момента), отсортированные по началу. Отсутствие `range` — 400,
 * значение не из enum — 422 с кодом `invalid_call_range`.
 */
@route("/api/calls")
@get
op listCalls(@query("range") callRange: CallRange): CallList | ValidationError;
