{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/home/runner/*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "permissions": [
        {
          "action": "external_directory",
          "resource": "/home/runner/*",
          "effect": "allow"
        }
      ]
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp",
      "codemode": false,
      "headers": {
        "Authorization": "Bearer {env:RENDER_API_KEY}"
      }
    }
  }
}
